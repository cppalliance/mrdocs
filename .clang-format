#
# clang-format searches upward from each formatted file for the nearest
# .clang-format, so this must live at the repository root (the common ancestor
# of include/, src/, libs/, tools/, tests/) to apply project-wide. Moving it
# into a subdirectory would only style that subtree.
#

# ---------------------------------------------------------------------------
# MrDocs Formatting Guidelines (Clang-Format Reference)
#
# This file encodes the style the MrDocs code is written in, which follows the
# conventions of earlier Boost projects. It is tuned to the code as it stands,
# so formatting the lines a change touches adds little churn. A whole-file run
# still rewrites about one line in ten, mostly where files disagree with each
# other, such as `if(` beside `if (`.
#
# - `python3 utils/format/format.py` formats the lines a change touched.
# - Running clang-format over whole files is a deliberate choice, made with
#   `format.py --all`, because it rewrites lines the change did not touch.
# - Lines wrap by hand, so ColumnLimit is 0 and existing line breaks stay.
# ---------------------------------------------------------------------------

Language: Cpp
Standard: Latest
BasedOnStyle: Microsoft

# Columns and Lines
# The code wraps long lines by hand, and a limit would rewrap many of them.
ColumnLimit: 0
# Comments keep their hand-wrapped lines.
ReflowComments: Never
TabWidth: 8
UseTab: Never
LineEnding: DeriveLF

# Breaking around braces
# Single-statement bodies appear with and without braces.
InsertBraces: false
BreakBeforeBraces: Custom
BraceWrapping:
  # Control
  AfterControlStatement: Always
  AfterCaseLabel: true
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: true
  # Definition
  AfterNamespace: false
  # Classes, structs and enums put the opening brace on its own line.
  AfterStruct: true
  AfterClass: true
  AfterEnum: true
  SplitEmptyRecord: false
  AfterFunction: true
  SplitEmptyFunction: false
  # A lambda body with a wrapped signature opens its brace on its own line.
  BeforeLambdaBody: true
  SplitEmptyNamespace: true
  AfterUnion: false
  AfterExternBlock: true
  # Extra
  IndentBraces: false

# Breaking around specifiers
#     Namespaces
CompactNamespaces: false
#     Templates
# `template<class T> using X = ...;` stays on one line.
BreakTemplateDeclarations: No
BreakBeforeConceptDeclarations: Always
#     Classes
BreakInheritanceList: BeforeComma
EmptyLineAfterAccessModifier: Never
EmptyLineBeforeAccessModifier: Leave
#     Functions
# Out-of-class definitions put the return type on its own line.
BreakAfterReturnType: TopLevelDefinitions
MaxEmptyLinesToKeep: 2
#     Strings
AlwaysBreakBeforeMultilineStrings: false
# String literals are never split across lines.
BreakStringLiterals: false
#     Expressions
BreakConstructorInitializers: BeforeComma
# A wrapped expression ends the line with its operator.
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false

# Breaking single line blocks
#     Control
AllowShortBlocksOnASingleLine: Never
# A case label with a single statement shares its line.
AllowShortCaseLabelsOnASingleLine: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
#     Declarations
AllowShortEnumsOnASingleLine: false
#     Function
# A function with a one-line body stays on one line.
AllowShortFunctionsOnASingleLine: All
# A wrapped declaration may start its parameters on the next line.
AllowAllParametersOfDeclarationOnNextLine: true
# A lambda that fits on one line stays on it.
AllowShortLambdasOnASingleLine: All
#     Expressions
# A wrapped call may start its arguments on the next line.
AllowAllArgumentsOnNextLine: true

# Indentation
#    Parameters
IndentWidth: 4
#    Definitions
NamespaceIndentation: None
IndentExternBlock: NoIndent
# Preprocessor directives start at the first column.
IndentPPDirectives: None
#    Classes
AccessModifierOffset: -4
IndentAccessModifiers: false
#    Templates
IndentRequiresClause: false
#    Functions
IndentWrappedFunctionNames: false
# A lambda body indents from its signature.
LambdaBodyIndentation: Signature
#    Control
ConstructorInitializerIndentWidth: 4
IndentCaseBlocks: false
IndentCaseLabels: false
IndentGotoLabels: true
#    Expressions
ContinuationIndentWidth: 4
InsertTrailingCommas: None
KeepEmptyLines:
  AtStartOfBlock: false

# Alignment
#    Macros
# A macro's value follows its name after one space.
AlignConsecutiveMacros: None
AttributeMacros: [ 'FUTURES_CONSTEXPR', 'FUTURES_NODISCARD' ]
IfMacros: [ 'FUTURES_IF_CONSTEXPR', 'SECTION', 'TEST_CASE' ]
TypenameMacros: [ 'FUTURES_DETAIL' ]
#    Declaration
PointerAlignment: Left
ReferenceAlignment: Pointer
DerivePointerAlignment: true
AlignConsecutiveDeclarations: None
QualifierAlignment: Custom
QualifierOrder: [ 'inline', 'static', 'constexpr', 'type', 'const' ]
#    Namespace
ShortNamespaceLines: 0
#    Brackets
# Wrapped arguments and parameters indent by the continuation width.
AlignAfterOpenBracket: DontAlign
#    Expressions
# Rows of a braced table keep the spacing the author gave them.
AlignArrayOfStructures: None
AlignConsecutiveAssignments: None
AlignConsecutiveBitFields: None
# Macro continuation backslashes follow the text.
AlignEscapedNewlines: DontAlign
# Continuation operands keep the indentation the author gave them.
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Always

# Spaces
# C-style casts write `(void)x`.
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: true
SpaceAroundPointerQualifiers: Default
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeCpp11BracedList: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatements
# Range-based for loops write `for (x : xs)`.
SpaceBeforeRangeBasedForLoopColon: true
SpacesInSquareBrackets: false
SpaceBeforeSquareBrackets: false
SpacesBeforeTrailingComments: 1
SpaceInEmptyBlock: false
SpacesInAngles: Never
SpacesInParens: Never
# Braced lists write `{a, b}` without inner spaces.
Cpp11BracedListStyle: true

# BinPack
# A wrapped call may put several arguments on one line.
BinPackArguments: true
# A wrapped signature keeps one parameter per line.
BinPackParameters: OnePerLine
BitFieldColonSpacing: After
# Packing follows the two options above in every file.
ExperimentalAutoDetectBinPacking: false
# Constructor initializers keep one per line.
PackConstructorInitializers: Never

# Penalties
PenaltyBreakAssignment: 512
PenaltyBreakBeforeFirstCallParameter: 512
PenaltyBreakComment: 512
PenaltyBreakFirstLessLess: 512
PenaltyBreakString: 512
PenaltyBreakTemplateDeclaration: 512
PenaltyExcessCharacter: 256
PenaltyIndentedWhitespace: 8
PenaltyReturnTypeOnItsOwnLine: 2

# Sorting
SortIncludes:
  Enabled: true
  IgnoreCase: true
SortUsingDeclarations: LexicographicNumeric
IncludeBlocks: Merge
IncludeCategories:
  - Regex: '^<mrdocs/Platform\.hpp>$'            # always first
    Priority: 0
  - Regex: '^".*"'                               # quoted (private, relative) come first
    Priority: 1
  - Regex: '^<mrdocs/.*>'                        # public project headers
    Priority: 2
  - Regex: '^<test_suite/.*>'                    # test suite headers
    Priority: 4
  - Regex: '^<clang/.*>'                         # clang headers
    Priority: 5
  - Regex: '^<llvm/.*>'                          # llvm headers
    Priority: 6
  - Regex: '^<fmt/.*>'                           # fmt headers
    Priority: 7
  - Regex: '^<duktape/.*>'                       # duktape headers
    Priority: 8
    # Lua headers
  - Regex: '^<lua.*>'                           # Lua headers
    Priority: 9
  - Regex: '^<(?!mrdocs/|clang/|llvm/|test_suite/|fmt/|duktape/)[^/]+/.*>' # other angle-bracket includes
    Priority: 10
  - Regex: '^<[^/]+>'                            # C++ standard headers like <vector>
    Priority: 11
  - Regex: '.*'                                  # fallback
    Priority: 12

# Comments
# Namespace-closing comments are written by hand, as `// mrdocs` or none.
FixNamespaceComments: false
CommentPragmas: '^ clang-format'

---
Language: Json
BasedOnStyle: llvm
