{{!--
    Renders a members table via the data-level markup/table partial.

    Routes each cell through markup/cell which dispatches by
    `$meta.type`: Symbols render through symbol/qualified-name
    (wrapped in markup/code) and Names render through type/name-info-text
    (linked via markup/a when a url is present).

    Parameters:
        members:       array of Symbol or Name items.
        isName:        true when items are Names (no doc.brief).
        includeBrief:  when true, a second column with the brief is emitted.

    See: https://mrdocs.com/docs/mrdocs/develop/generators.html#dom_reference
--}}
{{#if isName~}}
{{> markup/table
    headers=(arr "Name")
    items=members
    columns=(arr ".") }}
{{~else if includeBrief~}}
{{> markup/table
    weights=(arr 1 4)
    headers=(arr "Name" "Description")
    items=(filter_by members "extraction" "regular" "see-below")
    columns=(arr "." "doc.brief") }}
{{~else~}}
{{> markup/table
    headers=(arr "Name")
    items=(filter_by members "extraction" "regular" "see-below")
    columns=(arr ".") }}
{{~/if}}
