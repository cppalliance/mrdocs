{{! Protected base classes. }}
{{#if (any_of_by (reject symbol.bases @root.mrdocs.corpus.isImplementationDefined) "access" "protected")}}
{{#> markup/section name="protected-base-classes"}}
{{#> markup/dynamic-level-h }}Protected Base Classes{{/markup/dynamic-level-h~}}
{{> markup/table
    weights=(arr 1 4)
    headers=(arr "Name" "Description")
    items=(zip_objects (arr "type" "brief") (pluck (filter_by (reject symbol.bases @root.mrdocs.corpus.isImplementationDefined) "access" "protected") "type") (pluck (transform (pluck (filter_by (reject symbol.bases @root.mrdocs.corpus.isImplementationDefined) "access" "protected") "type.name.id") @root.mrdocs.corpus.get) "doc.brief"))
    columns=(arr "type" "brief") }}
{{/markup/section}}
{{/if}}
