{{! Exceptions thrown by the function (@throws). }}
{{#if symbol.doc.exceptions}}
{{#> markup/section name="exceptions"}}
{{#> markup/dynamic-level-h }}Exceptions{{/markup/dynamic-level-h~}}
{{> markup/table
    weights=(arr 1 4)
    headers=(arr "Name" "Thrown on")
