{{! Friend declarations. }}
{{#if symbol.friends}}
{{#> markup/section name="friends"}}
{{#> markup/dynamic-level-h }}Friends{{/markup/dynamic-level-h~}}
{{> markup/table
    weights=(arr 1 4)
    headers=(arr "Name" "Description")
    items=(zip_objects (arr "self" "brief") symbol.friends (pluck (transform (pluck symbol.friends "id") @root.mrdocs.corpus.get) "doc.brief"))
    columns=(arr "self" "brief") }}
{{/markup/section}}
{{/if}}
