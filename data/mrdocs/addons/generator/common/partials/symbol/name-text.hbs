{{!--
    Renders the symbol name in an appropriate format for section titles.

    This is typically a linked name, but it can also be a special name like
    "see-below" or "implementation-defined".

    Expected Context: {Symbol Object}

    Example:
        {{> declarator symbol }}

    See: https://mrdocs.com/docs/mrdocs/develop/generators.html#dom_reference
--}}
{{~#if (and (eq kind "function") (eq funcClass "conversion"))~}}
    {{! Conversion operator: "operator" and the type declarator ~}}
    operator {{>type/declarator-text returnType ~}}
{{~else if (eq kind "guide")~}}
    {{! Deduction guide: "deduced" type declarator ~}}
    {{>type/declarator-text deduced ~}}
{{~else~}}
    {{! Symbol with URL: link to the symbol documentation ~}}
    {{~#if name~}}
        {{~name~}}
    {{~else if parent ~}}
        Unnamed {{or keyKind kind~}}
    {{~else ~}}
        {{~! No name and no parent: the global namespace. With no nested
             namespaces (a C library, or a C++ library that uses none) it reads
             better as an index of everything than as a namespace. ~}}
        {{~#if members.namespaces~}}Global namespace{{~else~}}Global index{{~/if~}}
    {{~/if~}}
    {{~#if template.primary~}}
        {{! Explicit or partial template (has a primary): render the template arguments ~}}
        {{>template/args-text args=template.args ~}}
    {{~/if~}}
{{~/if~}}