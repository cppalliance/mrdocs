{{!--
    Renders a heading whose level depends on the layout mode.

    `level` (default 1) is the relative level inside the symbol page.
    When `multipage` is disabled the wrapper supplies an outer page
    title at level 1, so all sections shift down by one to make room.
    Either way the heading number matches `markup/h`'s absolute
    convention (level N -> N `=` chars in AsciiDoc, `<hN>` in HTML).

    Parameters:
        - partial block: heading text.
        - level: relative heading level (1, 2, ...).  Defaults to 1.
        - id:    optional anchor.

    Example:
        {{#> markup/dynamic-level-h level=2 id="section-id" }}Title{{/markup/dynamic-level-h}}

    See: https://mrdocs.com/docs/mrdocs/develop/generators.html#dom_reference
--}}
{{#> markup/h
    level=(add (or level 1) (select @root.config.multipage 1 2))
    id=id
    class=class
}}
{{> @partial-block }}
{{/markup/h}}
