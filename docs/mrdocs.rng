        </element>
      </optional>
      <zeroOrMore>
        <ref name="InlineNode"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="ListBlock">
    <element name="list">
      <optional>
        <element name="kind">
          <ref name="BlockKind"/>
