<script id="site-script" src="{{{uiRootPath}}}/js/site.js" data-ui-root-path="{{{uiRootPath}}}"></script>
<script async src="{{{uiRootPath}}}/js/vendor/highlight.js"></script>
{{#if env.SITE_SEARCH_PROVIDER}}
{{> search-scripts}}
{{/if}}
<script async src="{{{uiRootPath}}}/js/vendor/tabs.js" data-sync-storage-key="preferred-tab"></script>
{{!-- Render Mermaid once the module and the label font are ready, not on
     window load (start_on_load is off in antora-playbook.yml). The label font
     must be in: Mermaid sizes node boxes from it. Same URL as the playbook's
     mermaid_library_url, so this is the instance it already initialised. --}}
<script type="module">
  if (document.querySelector('.mermaid')) {
    Promise.all([
      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'),
      document.fonts.load('1em "Special Elite"'),
    ]).then(([{ default: mermaid }]) => mermaid.run())
  }
</script>
