<header class="header">
  <nav class="nav navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="/" aria-label="{{ site.title }} Home">
        {{> logo }}
      </a>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <search class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <input id="search-input" type="text" placeholder="Search the docs..."{{#if page.home}} autofocus{{/if}}>
        </div>
      </search>
      {{/if}}
      <button class="navbar-burger" aria-controls="nav-drawer" aria-expanded="false" aria-label="Toggle navigation menu">
        <svg class="burger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M3.25 19C3.25 18.5858 3.58579 18.25 4 18.25H20C20.4142 18.25 20.75 18.5858 20.75 19C20.75 19.4142 20.4142 19.75 20 19.75H4C3.58579 19.75 3.25 19.4142 3.25 19Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M3.25 5C3.25 4.58579 3.58579 4.25 4 4.25H20C20.4142 4.25 20.75 4.58579 20.75 5C20.75 5.41421 20.4142 5.75 20 5.75H4C3.58579 5.75 3.25 5.41421 3.25 5Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M3.25 12C3.25 11.5858 3.58579 11.25 4 11.25H20C20.4142 11.25 20.75 11.5858 20.75 12C20.75 12.4142 20.4142 12.75 20 12.75H4C3.58579 12.75 3.25 12.4142 3.25 12Z" fill="currentColor"/></svg>
        <svg class="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="https://www.mrdocs.com">Mr.Docs</a>
        <a class="navbar-item" href="https://cppalliance.org/">The C++ Alliance</a>
        {{!-- Figma 316:334658: a labelled gold button, not an icon-only link. --}}
        <a class="navbar-item navbar-repo" href="https://github.com/cppalliance/mrdocs">
          <span class="navbar-repo-icon" aria-hidden="true"></span>GitHub Repo
        </a>
        {{> theme-toggle class="navbar-item navbar-theme"}}
      </div>
    </div>
  </nav>
</header>
