{{! Symbol page header: title (single-page only) and brief block. }}
{{#> markup/section name="header"}}
{{#unless @root.config.multipage }}
{{! Single page documentation: symbol is not available to the wrapper but it's available here. }}
{{#> markup/h level=2 id=symbol.anchor }}{{> symbol/qualified-name-title symbol }}{{/markup/h}}
{{~/unless}}
{{#if symbol.doc.brief}}
{{#> markup/section name="brief"}}
{{> doc/block/brief symbol.doc.brief }}
{{/markup/section}}
{{/if}}
{{/markup/section}}
