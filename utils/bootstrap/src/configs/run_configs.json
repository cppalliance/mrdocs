{
  "configs": [
    {
      "name": "Test",
      "id": "test",
      "group": "Test",
      "depends": ["Unit Tests", "Golden Tests"]
    },
    {
      "name": "Run All Tests",
      "id": "run-all-tests",
      "group": "Test",
      "script": "${mrdocs_src_dir}/utils/testing/run_all_tests.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Unit Tests",
      "group": "Test",
      "target": "mrdocs-unit-tests",
      "args": [],
      "requires": ["build_tests"]
    },
    {
      "name": "XML Lint",
      "id": "xml-lint",
      "group": "Test",
      "ctest": ["-R", "^xml-lint$"],
      "requires": ["build_tests"]
    },
    {
      "name": "Integration Tests",
      "id": "integration-tests",
      "group": "Test",
      "ctest": ["-L", "integration"],
      "build_all": true,
      "requires": ["build_tests"]
    },
    {
      "name": "Schema Check",
      "id": "schema-check",
      "group": "Test",
      "ctest": ["-R", "^schema-check$"],
      "needs_target": "mrdocs",
      "requires": ["build_tests"]
    },
    {
      "name": "Self-Documentation",
      "id": "self-doc",
      "group": "Test",
      "ctest": ["-R", "^mrdocs-self-doc$"],
      "needs_target": "mrdocs",
      "requires": ["build_tests"]
    },
    {
      "name": "Golden Tests",
      "id": "golden-tests",
      "group": "Test",
      "target": "mrdocs-golden-tests",
      "folder": "Golden Tests",
      "args": [
        "${mrdocs_src_dir}/tests/golden/fixtures",
        "--action=test",
        "--addons=${mrdocs_src_dir}/data/mrdocs/addons",
        "--stdlib-includes=${mrdocs_stdlib_includes}",
        "--libc-includes=${mrdocs_src_dir}/data/mrdocs/headers/libc-stubs",
        "--log-level=warn"
      ],
      "requires": ["build_tests"]
    },
    {
      "name": "Update Golden Tests",
      "id": "update-golden-tests",
      "group": "Codegen",
      "target": "mrdocs-golden-tests",
      "folder": "Golden Tests",
      "args": [
        "${mrdocs_src_dir}/tests/golden/fixtures",
        "--action=update",
        "--addons=${mrdocs_src_dir}/data/mrdocs/addons",
        "--stdlib-includes=${mrdocs_stdlib_includes}",
        "--libc-includes=${mrdocs_src_dir}/data/mrdocs/headers/libc-stubs",
        "--log-level=warn"
      ],
      "requires": ["build_tests"]
    },
    {
      "name": "Create Golden Tests",
      "id": "create-golden-tests",
      "group": "Codegen",
      "target": "mrdocs-golden-tests",
      "folder": "Golden Tests",
      "args": [
        "${mrdocs_src_dir}/tests/golden/fixtures",
        "--action=create",
        "--addons=${mrdocs_src_dir}/data/mrdocs/addons",
        "--stdlib-includes=${mrdocs_stdlib_includes}",
        "--libc-includes=${mrdocs_src_dir}/data/mrdocs/headers/libc-stubs",
        "--log-level=warn"
      ],
      "requires": ["build_tests"]
    },
    {
      "name": "Remove Bad Test Files",
      "group": "Test",
      "script": "${mrdocs_src_dir}/tests/golden/fixtures/remove_bad_files.${docs_script_ext}",
      "args": [],
      "cwd": "${mrdocs_src_dir}/tests/golden/fixtures"
    },
    {
      "name": "Version",
      "group": "Run",
      "target": "mrdocs",
      "args": ["--version"]
    },
    {
      "name": "Help",
      "group": "Run",
      "target": "mrdocs",
      "args": ["--help"]
    },
    {
      "name": "Self-Reference",
      "group": "Documentation",
      "target": "mrdocs",
      "args": [
        "../CMakeLists.txt",
        "--config=${mrdocs_src_dir}/docs/mrdocs.yml",
        "--output=${mrdocs_src_dir}/docs/modules/reference/pages",
        "--generator=adoc",
        "--addons=${mrdocs_src_dir}/data/mrdocs/addons",
        "--stdlib-includes=${mrdocs_stdlib_includes}",
        "--libc-includes=${mrdocs_src_dir}/data/mrdocs/headers/libc-stubs",
        "--tagfile=reference.tag.xml",
        "--multipage=true",
        "--concurrency=${num_cores}",
        "--log-level=debug"
      ]
    },
    {
      "name": "Check Reference",
      "group": "Documentation",
      "target": "mrdocs",
      "args": [
        "../CMakeLists.txt",
        "--config=${mrdocs_src_dir}/docs/mrdocs.yml",
        "--generator=noop",
        "--addons=${mrdocs_src_dir}/data/mrdocs/addons",
        "--stdlib-includes=${mrdocs_stdlib_includes}",
        "--libc-includes=${mrdocs_src_dir}/data/mrdocs/headers/libc-stubs",
        "--concurrency=${num_cores}",
        "--log-level=warn"
      ]
    },
    {
      "name": "Build Local Docs",
      "group": "Documentation",
      "script": "${mrdocs_src_dir}/docs/build_local_docs.${docs_script_ext}",
      "needs_target": "mrdocs",
      "args": [],
      "cwd": "${mrdocs_src_dir}/docs",
      "env": {
        "MRDOCS_ROOT": "${mrdocs_install_dir}"
      }
    },
    {
      "name": "Build Docs",
      "group": "Documentation",
      "script": "${mrdocs_src_dir}/docs/build_docs.${docs_script_ext}",
      "needs_target": "mrdocs",
      "args": [],
      "cwd": "${mrdocs_src_dir}/docs",
      "env": {
        "MRDOCS_ROOT": "${mrdocs_install_dir}"
      }
    },
    {
      "name": "Build UI Bundle",
      "group": "Documentation",
      "script": "${mrdocs_src_dir}/docs/ui/build.${docs_script_ext}",
      "args": [],
      "cwd": "${mrdocs_src_dir}/docs/ui"
    },
    {
      "name": "Render Landing Page",
      "group": "Documentation",
      "script": "${mrdocs_src_dir}/docs/website/render.js",
      "folder": "Render Landing Page",
      "args": [],
      "cwd": "${mrdocs_src_dir}/docs/website",
      "env": {
        "NODE_ENV": "production",
        "MRDOCS_ROOT": "${mrdocs_install_dir}"
      }
    },
    {
      "name": "Clean Install Website Dependencies",
      "group": "Documentation",
      "script": "npm",
      "args": ["ci"],
      "cwd": "${mrdocs_src_dir}/docs/website"
    },
    {
      "name": "Install Website Dependencies",
      "group": "Documentation",
      "script": "npm",
      "args": ["install"],
      "cwd": "${mrdocs_src_dir}/docs/website"
    },
    {
      "name": "Check Layout",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/check_layout.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Check README Length",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/check_readme_length.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Check Page Length",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/check_page_length.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Check Section Titles",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/check_section_titles.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Check Header Rules",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/check_header_rules.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Lint",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/lint.py",
      "args": [],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Lint the Whole Tree",
      "group": "Develop",
      "script": "${mrdocs_src_dir}/utils/lint/lint.py",
      "args": ["--all"],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Test the Lint Scripts",
      "group": "Develop",
      "script": "python3",
      "args": ["-I", "-m", "unittest", "discover", "-s", "${mrdocs_src_dir}/utils/lint/tests", "-t", "${mrdocs_src_dir}/utils/lint"],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Test the Format Script",
      "group": "Develop",
      "script": "python3",
      "args": ["-I", "-m", "unittest", "discover", "-s", "${mrdocs_src_dir}/utils/format/tests", "-t", "${mrdocs_src_dir}/utils/format"],
      "cwd": "${mrdocs_src_dir}"
    },
    {
      "name": "Test the Linters",
      "id": "test-the-linters",
      "group": "Develop",
      "depends": ["Test the Lint Scripts", "Test the Format Script"]
    }
  ]
}
